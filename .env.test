# ============================================================================
# Ambiente (importante para el filtro de fecha)
# ============================================================================
ENVIRONMENT=development
#ENVIRONMENT=production

# ============================================================================
# CONFIGURACIÓN MBA3 - base pruebas
# ============================================================================
MBA3_BASE_URL=http://192.168.2.159:8081
MBA3_CODIGO=CDB002
MBA3_PWD=88888
MBA3_DIGEST_USERNAME=CDB002
MBA3_DIGEST_PASSWORD=88888

# ============================================================================
# CONFIGURACIÓN SQL SERVER PRINCIPAL (Almacenamiento de datos, Servidor DESARROLLO/PRUEBAS)
# ============================================================================
SQL_SERVER_DRIVER={ODBC Driver 17 for SQL Server}
SQL_SERVER_SERVER=210.17.1.54,1433
SQL_SERVER_DATABASE=store_control
SQL_SERVER_UID=desadmin
SQL_SERVER_PWD=M4B31$tr$d3s4rr0ll0*BDl0g1n#1*

# ============================================================================
# CONFIGURACIÓN SQL SERVER SAP (Consultas OPENQUERY DESARROLLO/PRUEBAS)
# ============================================================================
SQL_SERVER_SAP_DRIVER={ODBC Driver 17 for SQL Server}
SQL_SERVER_SAP_SERVER=10.10.100.12
SQL_SERVER_SAP_DATABASE=STORECONTROL
SQL_SERVER_SAP_UID=consultas
SQL_SERVER_SAP_PWD=Datos.22

# ============================================================================
# CONFIGURACIÓN GENERAL
# ============================================================================
ENABLE_SQL_SERVER_STORAGE=true
   
# ============================================================================
# CONFIGURACIÓN SAP (HANA)
# ============================================================================
SAP_LINKED_SERVER=MYHANADB
SAP_DATABASE=TEST_MABEL
SAP_SCHEMA=TEST_MABEL
#SAP_DATABASE=SBO_MABEL_PROD
#SAP_SCHEMA=SBO_MABEL_PROD
ENABLE_SAP_QUERIES=true
SAP_CACHE_DAYS=30

# ============================================================================
# CONFIGURACIÓN SAP (SERVICE LAYER)
# ============================================================================
# ⚠️ IMPORTANTE: URL base SIN /Login (se agrega en cliente)
SAP_SERVICE_LAYER_URL=http://10.10.41.4:50001/b1s/v1
SAP_SERVICE_LAYER_USERNAME=MZ-SIS-05
SAP_SERVICE_LAYER_PASSWORD=2120
SAP_SERVICE_LAYER_DATABASE=TEST_MABEL
ENABLE_SAP_SERVICE_LAYER=true
SAP_SERVICE_LAYER_TIMEOUT=30
SAP_SERVICE_LAYER_VERIFY_SSL=false

# ============================================================================
# JWT Configuration (debe coincidir con el Core)
# ============================================================================
# ⚠️ CRÍTICO: Generar un JWT_SECRET único y seguro (64+ caracteres aleatorios)
# Ejecuta en PowerShell: -join ((65..90) + (97..122) + (48..57) | Get-Random -Count 64 | % {[char]$_})
# O en Python: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=clave_super_secreta_para_jwt_12345
JWT_ISSUER=SCNexus.Core
JWT_AUDIENCE=SCNexus.Users

# Habilitar autenticación JWT
ENABLE_JWT_AUTH=true

# ============================================================================
# Configuración de SCNexus.Core API (Active Directory)
# ============================================================================
CORE_API_URL=http://192.168.2.12:8080
CORE_API_TIMEOUT=30

# ============================================================================
# Migración Automática
# ============================================================================
# El filtro de fecha se detecta automáticamente según ENVIRONMENT:
# - development: 30 días (1 mes)
# - production: 1 día (24 horas)
# Puedes sobrescribir con:
MIGRATE_DATE_FILTER_DAYS=365  # Para desarrollo y produccion

# ============================================================================
# Notificaciones por Email (Outlook)
# ============================================================================
ENABLE_EMAIL_NOTIFICATIONS=true

# Configuración SMTP Outlook (relay interno)
EMAIL_SMTP_SERVER=mabeltrading-com-ec.mail.protection.outlook.com
EMAIL_SMTP_PORT=25
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=

# Direcciones de correo
EMAIL_FROM=integrationsap@mabeltrading.com.ec
EMAIL_DEV_OVERRIDE=cortiz@mabeltrading.com.ec
EMAIL_TO=cortiz@mabeltrading.com.ec

# ============================================================================
# Servidor Celery para ejecutar tareas en segundo plano (plantillas, cruce, etc.)
# ============================================================================
REDIS_URL=redis://localhost:6379/0
# Migración automática (legacy): deshabilitada. El worker solo procesa plantillas/cruce/sync.
# Activar solo si MBA3 está disponible y quieres migración periódica: ENABLE_AUTO_MIGRATE=true
ENABLE_AUTO_MIGRATE=false
AUTO_MIGRATE_INTERVAL_MINUTES=15

# ============================================================================
# Storage de Archivos (MinIO/S3)
# ============================================================================
# Habilitar almacenamiento de archivos Excel originales
ENABLE_FILE_STORAGE=true

# Configuración MinIO (compatible con S3)
# Para desarrollo local: docker run -p 9000:9000 -p 9001:9001 minio/minio server /data --console-address ":9001"
FILE_STORAGE_ENDPOINT=http://localhost:9100
FILE_STORAGE_ACCESS_KEY=minioadmin
FILE_STORAGE_SECRET_KEY=minioadmin
FILE_STORAGE_BUCKET=excel-files
FILE_STORAGE_REGION=us-east-1
# Para S3 real, usar: FILE_STORAGE_ENDPOINT=https://s3.amazonaws.com